{
  "name": "gunluk",
  "version": "1.0.0",
  "description": "Yerel, şifreli, yalnızca düz metin destekli, takvim tabanlı çapraz platform günlük uygulaması.",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:electron": "tsc -p tsconfig.node.json && node scripts/launch-electron.cjs --dev",
    "build": "vite build && tsc -p tsconfig.node.json",
    "preview": "npm run build && node scripts/launch-electron.cjs",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "journal",
    "diary",
    "electron",
    "encrypted",
    "local-first",
    "calendar",
    "plain-text"
  ],
  "dependencies": {
    "lucide-react": "^1.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
